cabal-version:      2.4
name:               Coup
version:            0.1.0.0
author:             Adam Bildersee
maintainer:         saltz.adam@gmail.com

library
    hs-source-dirs: .
    build-depends: base, containers, lens, text, brick, haskBoard, vty,
                 finitary, Helpers, aeson, nonempty-containers
    exposed-modules: Coup, Objects, Tui
    default-language: Haskell2010
    ghc-options:  -Wall
    default-extensions: DeriveFunctor, DeriveGeneric, FlexibleContexts, GADTs, TypeApplications, FlexibleInstances, DataKinds, DuplicateRecordFields, OverloadedLabels, ScopedTypeVariables, TypeOperators, NoFieldSelectors, MultiParamTypeClasses, DeriveAnyClass

executable Coup
    main-is: Main.hs
    hs-source-dirs: app
    build-depends: base, Coup, haskBoard, containers, lens, brick
    default-extensions: DeriveFunctor, DeriveGeneric, FlexibleContexts, GADTs, TypeApplications, FlexibleInstances, DataKinds, DuplicateRecordFields, OverloadedLabels, ScopedTypeVariables, TypeOperators, NoFieldSelectors, MultiParamTypeClasses
    default-language: Haskell2010
    ghc-options: -Wall -threaded
